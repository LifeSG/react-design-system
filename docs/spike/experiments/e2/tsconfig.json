{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": false,
        "noEmit": true,
        "incremental": true,
        "module": "esnext",
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "include": [
        "next-env.d.ts",
        ".next-turbopack-default/types/**/*.ts",
        ".next-turbopack-default/dev/types/**/*.ts",
        "**/*.mts",
        "**/*.ts",
        "**/*.tsx",
        ".next-turbopack-graph/types/**/*.ts",
        ".next-turbopack-graph/dev/types/**/*.ts",
        ".next-webpack-default/types/**/*.ts",
        ".next-webpack-default/dev/types/**/*.ts",
        ".next-webpack-strict/types/**/*.ts",
        ".next-webpack-strict/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
